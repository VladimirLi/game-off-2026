{
  "autoMemoryEnabled": false,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-checks.py\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-model-guard.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/persona-blind.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.py\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "node *play.js *",
      "node tools/bot.js*"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node *play.js *)",
      "Bash(.claude/scripts/persona-run.sh *)",
      "Bash(node tools/solve.js*)",
      "Bash(node tools/bot.js*)"
    ]
  }
}